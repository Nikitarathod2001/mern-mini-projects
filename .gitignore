```gitignore
# =========================
# Dependencies
# =========================
**/node_modules/
**/bower_components/

# =========================
# Environment Variables
# =========================
**/.env
**/.env.*
!.env.example

# =========================
# Build Output
# =========================
**/dist/
**/build/
**/out/
**/.next/
**/.nuxt/
**/.output/

# =========================
# Coverage Reports
# =========================
**/coverage/
**/.nyc_output/

# =========================
# Logs
# =========================
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Cache
# =========================
**/.cache/
**/.parcel-cache/
**/.eslintcache
**/.vite/
**/.turbo/

# =========================
# Runtime Files
# =========================
**/*.pid
**/*.seed
**/*.pid.lock

# =========================
# Operating System Files
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# Package Managers
# =========================
.pnpm-store/
.npm/
.yarn/

# =========================
# Temporary Files
# =========================
tmp/
temp/
*.tmp

# =========================
# Firebase
# =========================
.firebase/

# =========================
# Docker (Optional)
# =========================
docker-compose.override.yml

# =========================
# Miscellaneous
# =========================
*.tgz
```
